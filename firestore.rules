rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /licenses/{licenseId} {
      // Individual client POS instances can verify their specific license status
      allow get: if isValidId(licenseId);
      // Prevent unauthorized enumeration of all client stores
      allow list: if request.auth != null;

      // Only authenticated admin dashboard can create or modify licenses
      allow write: if request.auth != null;
    }

    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
