rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /licenses/{licenseId} {
      // Individual client POS instances can verify their specific license status
      allow get: if isValidId(licenseId);
      // Prevent unauthorized enumeration of all client stores
      allow list: if request.auth != null;

      // Allow client app during installation or activation code upgrade to update business info and edition
      // while preventing an already-suspended license from self-activating without authorization
      allow update: if isValidId(licenseId) &&
        !(
          resource.data.get('estado_remoto', 'ACTIVO') == 'SUSPENDIDO' &&
          request.resource.data.get('estado_remoto', 'SUSPENDIDO') != 'SUSPENDIDO'
        );

      // Allow creation with valid license ID
      allow create: if isValidId(licenseId);

      // Only authenticated admin dashboard can delete or perform unrestricted writes
      allow write: if request.auth != null;
    }

    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
