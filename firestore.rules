rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /licenses/{licenseId} {
      // Individual client POS instances can verify their specific license status
      allow get: if isValidId(licenseId);
      // Prevent unauthorized enumeration of all client stores
      allow list: if request.auth != null;

      // Allow client app during installation to auto-register business info for its own licenseId
      // without modifying protected fields like cuota, vencimiento, or estado_remoto
      allow update: if isValidId(licenseId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'cuota_mensual_usd', 'cuota', 'monto_instalacion_usd', 'instalacion',
          'fecha_vencimiento_actual', 'fecha_vencimiento', 'vencimiento',
          'estado_remoto', 'estado', 'status', 'dias_gracia_offline_max', 'motivo_bloqueo'
        ]);

      // Allow creation with valid license ID
      allow create: if isValidId(licenseId);

      // Only authenticated admin dashboard can delete or perform unrestricted writes
      allow write: if request.auth != null;
    }

    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
